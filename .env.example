# ==============================================================================
# NIGHTSCOUT MONITOR - CONFIGURATION
# ==============================================================================
#
# READ THIS FIRST - two different tiers live in this file, and they
# behave completely differently after you first run `docker compose up`:
#
#   TIER 1 - Postgres password (below). Lives here PERMANENTLY. There is no
#            "later" for this one - editing it after first boot does nothing
#            on its own (Postgres already has its password set from whatever
#            was in this file the very first time its data volume was
#            created). If you need to change it later, that's a manual
#            Postgres operation (ALTER USER ...), not a file edit.
#
#   TIER 2 - Daemon settings (POLL_PERIOD_SECONDS, RETENTION_DAYS, etc).
#            These values only matter on the very first boot, to seed the
#            database. From then on, the Settings page in the web UI is the
#            real source of truth, and this file is just a fallback for any
#            key that's missing from the database. Editing this file after
#            first boot has NO EFFECT unless you set FORCE_CONFIG_OVERWRITE=
#            true, which forces the database to be overwritten with these
#            values on the next restart only - a deliberate emergency/reset
#            switch, not a normal way to change settings.
#
# In short: everything in this file only truly matters ONCE, on first boot.
# After that, ongoing changes happen either in this app's own Settings page
# (Tier 2), or via a manual database command (Tier 1, rare).
#
# ==============================================================================


# ------------------------------------------------------------------------------
# TIER 1: POSTGRES - permanent, .env only, forever
# ------------------------------------------------------------------------------
# This is the actual database password. It cannot live anywhere else - the
# database itself is where every other "source of truth" (Tier 2's settings
# table, Grafana/Metabase's own data) actually lives, so its own password
# can't be stored inside itself. Set this once, before first boot, and treat
# it as fixed thereafter.
POSTGRES_PASSWORD=changeme_strong_value

# Host directory for persistent PostgreSQL data storage.
# Defaults to /var/lib/nightscout-monitor/postgres if left unset.
# Must NOT point inside the git repository working tree.
# POSTGRES_DATA_DIR=/var/lib/nightscout-monitor/postgres

# Optional: Host port mappings (change these if running multiple instances or ports are occupied)
# WEB_PORT=8080
# DB_PORT=5432

# DB_HOST / DB_NAME / DB_USER are intentionally not listed here - they
# default to postgres / nightscout / admin, matching docker-compose.yml's
# own service definitions exactly. Only set these if you've changed those
# defaults in docker-compose.yml itself.


# ------------------------------------------------------------------------------
# TIER 2: DAEMON SETTINGS - env seeds the DB on first boot, then the
#          Settings page (Web UI) takes over as the real source of truth
# ------------------------------------------------------------------------------

# EMERGENCY OVERRIDE:
# Set to 'true' to force-overwrite the database with the values in this file
# on the NEXT restart only. Remember to set it back to 'false' afterwards -
# leaving it 'true' means every restart wipes out any changes made in the
# Settings page.
FORCE_CONFIG_OVERWRITE=false

# Your Nightscout URL (must end in /api/v1)
NIGHTSCOUT_URL=https://your-nightscout-instance.example.com/api/v1

# Your Nightscout API Secret/Access Token (used for authentication)
# This is not the password you normally use to access your nightscout
# A token can be generated from the admin menu on nightscout
# with a 'readable' role
API_SECRET=changeme_strong_value

# Keep Flask's interactive debugger disabled for normal deployments.
FLASK_DEBUG=false

# Local Timezone (e.g., Asia/Singapore, America/New_York)
TIMEZONE=Australia/Perth

# Main polling interval in seconds (default: 5 minutes)
POLL_PERIOD_SECONDS=300

# Small buffer added to the poll timing
POLL_OFFSET_SECONDS=30

# Retention policy: Purge records older than X days
RETENTION_DAYS=365

# Maximum history days for the 5-minute timeline (spine bounding - CRIT-1 fix).
# Views older than this cut-off are not regenerated on every refresh.
# Reducing this improves refresh performance at the cost of historical detail.
MAX_HISTORY_DAYS=120

# ----- Backfill pacing -----
# How many days of data to request per API call.
# Smaller chunks are more reliable on slow Nightscout servers.
BACKFILL_CHUNK_DAYS_ENTRIES=60
BACKFILL_CHUNK_DAYS_TREATMENTS=60
BACKFILL_CHUNK_DAYS_DEVICESTATUS=60

# Maximum number of records returned per API page (Nightscout default max is
# 1000, but many self-hosted instances can handle 5000+).
BACKFILL_PAGE_SIZE=10000

# Sleep duration (seconds) between fetching pages within a single chunk.
BACKFILL_SLEEP_BETWEEN_PAGES_SEC=0.6

# Delay between consecutive fetch windows (seconds)
BACKFILL_DELAY_SECONDS=0.2

# ----- Monitoring -----
# URL to ping after every successful poll (e.g., Uptime-Kuma, Healthchecks.io)
HEALTHCHECK_URL=https://your-healthcheck-ping-url.example.com
