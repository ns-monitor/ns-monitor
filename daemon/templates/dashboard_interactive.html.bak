<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Dashboard - Nightscout</title>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        :root {
            --bg-color: #1a1a1a;
            --card-bg: #2d2d2d;
            --text-color: #e0e0e0;
            --accent: #3498db;
            --success: #2ecc71;
            --warning: #f1c40f;
            --danger: #e74c3c;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        h1,
        h2 {
            border-bottom: 2px solid var(--card-bg);
            padding-bottom: 10px;
        }

        .card {
            background-color: var(--card-bg);
            padding: 20px 20px 10px 20px;
            /* Reduced bottom padding */
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .header-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .header-controls form {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
        }

        label {
            color: #aaa;
            font-size: 0.9em;
            margin-right: 5px;
        }

        input[type="date"],
        select {
            padding: 8px;
            background: #444;
            border: 1px solid #555;
            color: white;
            border-radius: 4px;
        }

        button {
            background-color: var(--success);
            color: white;
            border: none;
            padding: 9px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.95em;
        }

        button:hover {
            opacity: 0.9;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th,
        td {
            text-align: left;
            padding: 12px 10px;
            border-bottom: 1px solid #444;
        }

        th {
            color: #888;
            font-weight: normal;
            font-size: 0.9em;
            text-transform: uppercase;
        }

        .highlight-col {
            background-color: rgba(52, 152, 219, 0.1);
            color: #6fbcf0;
            font-weight: bold;
        }

        input[type="checkbox"] {
            cursor: pointer;
        }

        /* Tooltip Container */
        .tooltip {
            position: relative;
            display: inline-block;
            cursor: help;
        }

        /* Tooltip text - Now appearing BELOW to avoid chart clipping */
        .tooltip .tooltiptext {
            display: none;
            width: 280px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 12px;
            position: absolute;
            z-index: 10000;
            top: 130%;
            /* Below the legend */
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.85em;
            line-height: 1.5;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
            border: 1px solid #666;
            pointer-events: none;
        }

        /* Show tooltip on hover */
        .tooltip:hover .tooltiptext {
            display: block;
        }

        /* Tooltip arrow (pointing UP now) */
        .tooltip .tooltiptext::after {
            content: "";
            position: absolute;
            bottom: 100%;
            left: 50%;
            margin-left: -6px;
            border-width: 6px;
            border-style: solid;
            border-color: transparent transparent #333 transparent;
        }

        .agp-container {
            width: 100%;
            display: flex;
            justify-content: center;
            background: #fff;
            /* White bg for the chart image itself */
            border-radius: 4px;
            overflow: hidden;
            min-height: 480px;
            position: relative;
        }

        .agp-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(45, 45, 45, 0.9);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #aaa;
        }

        .text-center {
            text-align: center;
        }

        .text-muted {
            color: #888;
            font-size: 0.85em;
        }

        /* Hamburger Menu */
        .hamburger {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: var(--card-bg);
            padding: 10px;
            border-radius: 4px;
            cursor: pointer;
            border: 1px solid #444;
            display: flex;
            flex-direction: column;
            gap: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }

        .hamburger span {
            display: block;
            width: 25px;
            height: 3px;
            background: var(--text-color);
            transition: 0.3s;
        }

        .nav-menu {
            position: fixed;
            top: 0;
            right: -300px;
            width: 250px;
            height: 100vh;
            background: var(--card-bg);
            box-shadow: -5px 0 15px rgba(0, 0, 0, 0.5);
            z-index: 999;
            transition: 0.3s;
            padding: 70px 20px 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            box-sizing: border-box;
        }

        .nav-menu.open {
            right: 0;
        }

        .nav-menu a {
            color: var(--text-color);
            text-decoration: none;
            padding: 12px;
            border-radius: 4px;
            transition: 0.2s;
        }

        .nav-menu a:hover {
            background: var(--accent);
            color: white;
        }

        .menu-section {
            color: #666;
            font-size: 0.75em;
            text-transform: uppercase;
            margin-top: 15px;
            margin-bottom: 5px;
            padding-left: 12px;
        }

        @media print {
            body {
                background: white;
                color: black;
                padding: 0;
            }

            .card {
                background: white;
                box-shadow: none;
                border: 1px solid #ddd;
                padding: 10px;
            }

            h1,
            h2,
            th,
            label,
            .text-muted {
                color: #333;
            }

            input,
            select,
            button,
            .hamburger,
            .nav-menu {
                display: none !important;
            }

            .print-break-avoid {
                page-break-inside: avoid;
            }

            th,
            td {
                border-bottom: 1px solid #ddd;
            }
        }
    </style>
</head>

<body>
    {% include "sidebar.html" %}

    <!-- Version Toggle Buttons -->
    <div style="max-width: 1200px; margin: 10px auto; display: flex; gap: 10px; justify-content: center;">
        <a href="/static?start_date={{ start_date }}&end_date={{ end_date }}" class="btn"
            style="background: transparent; color: var(--text-color); padding: 5px 15px; border-radius: 4px; text-decoration: none; font-size: 0.9em; border: 2px solid #555;">Metrics</a>
        <a href="/interactive?start_date={{ start_date }}&end_date={{ end_date }}" class="btn"
            style="background: var(--accent); color: #fff; padding: 5px 15px; border-radius: 4px; text-decoration: none; font-size: 0.9em; font-weight: bold; border: 2px solid var(--accent);">Trends</a>
        <a href="/daily" class="btn"
            style="background: transparent; color: var(--text-color); padding: 5px 15px; border-radius: 4px; text-decoration: none; font-size: 0.9em; border: 2px solid #555;">Daily</a>
    </div>

    <!-- Dashboard Version 1.2.0-BETA - Interactive Charts -->
    <div class="container">
        <!-- Integrity Alert -->
        {% if has_gaps %}
        <div
            style="background: rgba(231, 76, 60, 0.2); border: 1px solid var(--danger); color: #ffadad; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.4em;">⚠️</span>
                <span><strong>Data Continuity Alert:</strong> Gaps detected in recent ingestion. Charts may be
                    incomplete.</span>
            </div>
            <a href="/maintenance" class="btn"
                style="background: var(--danger); color: white; padding: 6px 14px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.85em;">Repair
                Gaps</a>
        </div>
        {% endif %}

        <!-- Header Controls -->
        <h1 style="border-bottom: 2px solid var(--card-bg); padding-bottom: 10px; margin-top: 0;">Trends
        </h1>

        <div class="card"
            style="padding: 10px 15px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                <button type="button" id="prev-period-btn" onclick="shiftPeriod(-1)"
                    style="background:#444; color:#e0e0e0; border:1px solid #555; border-radius:4px; padding:6px 11px; cursor:pointer; font-size:1.1em; line-height:1;"
                    title="Previous period">&#8592;</button>
                <select id="date-preset" onchange="syncAndApplyPreset()"
                    style="padding: 8px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                    <option value="">Custom Range...</option>
                    <option value="7">Last 7 Days</option>
                    <option value="14">Last 14 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="60">Last 60 Days</option>
                    <option value="90">Last 90 Days</option>
                    <option value="180">Last 180 Days</option>
                    <option value="" disabled style="color:#666;">──────────────</option>
                    <option value="prev_1m">Previous Month</option>
                    <option value="prev_3m">Previous 3 Months</option>
                    <option value="prev_6m">Previous 6 Months</option>
                    <option value="prev_12m">Previous 12 Months</option>
                </select>
                <button type="button" id="next-period-btn" onclick="shiftPeriod(1)"
                    style="background:#444; color:#e0e0e0; border:1px solid #555; border-radius:4px; padding:6px 11px; cursor:pointer; font-size:1.1em; line-height:1;"
                    title="Next period">&#8594;</button>
                <label style="display: flex; align-items: center; gap: 5px; color: #e0e0e0; cursor: pointer;">
                    <input type="checkbox" id="include-today" onchange="syncAndApplyPreset()"> Include Today
                </label>
            </div>

            <form method="GET" action="/interactive" id="date-form"
                style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; margin: 0;">
                <div style="display: flex; align-items: center; gap: 5px;">
                    <label for="start_date" style="margin: 0;">From:</label>
                    <input type="date" id="start_date" name="start_date" value="{{ start_date }}"
                        onchange="syncAndSubmit('start_date')"
                        style="padding: 6px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                </div>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <label for="end_date" style="margin: 0;">To:</label>
                    <input type="date" id="end_date" name="end_date" value="{{ end_date }}"
                        onchange="syncAndSubmit('end_date')"
                        style="padding: 6px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                </div>
                <!-- Hidden inputs to persist checkbox state -->
                <input type="hidden" name="show_basal" id="hidden-basal" value="1">
                <input type="hidden" name="show_iob" id="hidden-iob" value="1">
                <input type="hidden" name="show_carbs" id="hidden-carbs" value="1">
                <!-- Trend Toggles -->
                <input type="hidden" name="show_gmi" id="hidden-gmi" value="1">
                <input type="hidden" name="show_tir" id="hidden-tir" value="1">
                <input type="hidden" name="show_titr" id="hidden-titr" value="1">
                <input type="hidden" name="show_cv" id="hidden-cv" value="1">
                <input type="hidden" name="show_gvi" id="hidden-gvi" value="0">
                <input type="hidden" name="show_lbgi" id="hidden-lbgi" value="0">
                <input type="hidden" name="show_hbgi" id="hidden-hbgi" value="0">
            </form>
        </div>

        <!-- 1. AGP Visualization (Single Chart) -->
        <div class="card print-break-avoid">
            <h2>
                Ambulatory Glucose Profile
                <span class="text-muted" style="float:right; font-weight:normal; font-size:0.8em; margin-top:6px;">{{
                    start_date }} to {{ end_date }}</span>
            </h2>
            <div class="agp-container"
                style="min-height: 520px; background: #fff; padding: 5px; border-radius: 4px; display: block;">
                <div class="loading-overlay" id="agp-loading">Fetching clinical data...</div>
                <div id="agp-chart-node" style="min-height: 400px; width:100%;"></div>
            </div>
        </div>

        <!-- 1b. Metabolic Daily Trends -->
        <div class="card print-break-avoid">
            <h2>
                Metabolic Trends
                <span class="text-muted" style="float:right; font-weight:normal; font-size:0.8em; margin-top:6px;">Daily
                    Overlays: {{ start_date }} to {{ end_date }}</span>
            </h2>
            <div class="agp-container"
                style="min-height: 520px; background: #fff; padding: 5px; border-radius: 4px; display: block; border: 1px solid #ddd;">
                <div class="loading-overlay" id="trends-loading"
                    style="background: rgba(255,255,255,0.8); color: #333;">
                    Fetching clinical data...</div>
                <div id="trends-chart-node" style="min-height: 480px; width:100%;"></div>
            </div>
            <!-- Time Range Grain Selectors -->
            <div
                style="display: flex; justify-content: center; gap: 20px; margin-top: 10px; padding: 10px; border-top: 1px solid #444;">
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-1" checked onchange="toggleGrain('1')"> 1-Day (Daily)
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-7" onchange="toggleGrain('7')"> 7-Day MAvg
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-14" onchange="toggleGrain('14')"> 14-Day MAvg
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-30" onchange="toggleGrain('30')"> 30-Day MAvg
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-60" onchange="toggleGrain('60')"> 60-Day MAvg
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: #888; cursor: pointer; font-size: 0.9em;">
                    <input type="checkbox" id="grain-90" onchange="toggleGrain('90')"> 90-Day MAvg
                </label>
                <label
                    style="display: flex; align-items: center; gap: 8px; color: var(--success); cursor: pointer; font-size: 0.9em; font-weight: bold;">
                    <input type="checkbox" id="grain-monthly" onchange="toggleGrain('monthly')"> Monthly Avg
                </label>
            </div>
        </div>

        <!-- Mirrored Date Selector -->
        <div class="card"
            style="padding: 10px 15px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; border-top: 1px solid #444;">
            <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                <button type="button" id="prev-period-btn-bottom" onclick="shiftPeriod(-1, true)"
                    style="background:#444; color:#e0e0e0; border:1px solid #555; border-radius:4px; padding:6px 11px; cursor:pointer; font-size:1.1em; line-height:1;"
                    title="Previous period">&#8592;</button>
                <select id="date-preset-bottom" onchange="syncAndApplyPreset(true)"
                    style="padding: 8px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                    <option value="">Custom Range...</option>
                    <option value="7">Last 7 Days</option>
                    <option value="14">Last 14 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="60">Last 60 Days</option>
                    <option value="90">Last 90 Days</option>
                    <option value="180">Last 180 Days</option>
                    <option value="" disabled style="color:#666;">──────────────</option>
                    <option value="prev_1m">Previous Month</option>
                    <option value="prev_3m">Previous 3 Months</option>
                    <option value="prev_6m">Previous 6 Months</option>
                    <option value="prev_12m">Previous 12 Months</option>
                </select>
                <button type="button" id="next-period-btn-bottom" onclick="shiftPeriod(1, true)"
                    style="background:#444; color:#e0e0e0; border:1px solid #555; border-radius:4px; padding:6px 11px; cursor:pointer; font-size:1.1em; line-height:1;"
                    title="Next period">&#8594;</button>
                <label style="display: flex; align-items: center; gap: 5px; color: #e0e0e0; cursor: pointer;">
                    <input type="checkbox" id="include-today-bottom" onchange="syncAndApplyPreset(true)"> Include Today
                </label>
            </div>

            <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; margin: 0;">
                <div style="display: flex; align-items: center; gap: 5px;">
                    <label for="start_date-bottom" style="margin: 0;">From:</label>
                    <input type="date" id="start_date-bottom" value="{{ start_date }}"
                        onchange="syncAndSubmit('start_date-bottom')"
                        style="padding: 6px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                </div>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <label for="end_date-bottom" style="margin: 0;">To:</label>
                    <input type="date" id="end_date-bottom" value="{{ end_date }}"
                        onchange="syncAndSubmit('end_date-bottom')"
                        style="padding: 6px; background: #444; border: 1px solid #555; color: white; border-radius: 4px;">
                </div>
            </div>
        </div>

        <!-- 2. Metrics Comparison Table -->

        <div class="text-center text-muted" style="margin-bottom: 30px;">
            Generated by Nightscout Daemon
        </div>
    </div>

    <script>
        const hamburger = document.getElementById('hamburger-btn');
        const navMenu = document.getElementById('nav-menu');

        // Hover-based menu
        hamburger.addEventListener('mouseenter', () => navMenu.classList.add('open'));
        navMenu.addEventListener('mouseenter', () => navMenu.classList.add('open'));

        hamburger.addEventListener('mouseleave', (e) => {
            if (!e.relatedTarget || !navMenu.contains(e.relatedTarget)) {
                navMenu.classList.remove('open');
            }
        });

        navMenu.addEventListener('mouseleave', (e) => {
            if (!e.relatedTarget || !hamburger.contains(e.relatedTarget)) {
                navMenu.classList.remove('open');
            }
        });


        // initControls() - logic consolidated at end of file

        function syncAndSubmit(sourceId) {
            const isBottom = sourceId.endsWith('-bottom');
            const baseId = isBottom ? sourceId.replace('-bottom', '') : sourceId;
            const targetId = isBottom ? baseId : sourceId + '-bottom';
            const sourceEl = document.getElementById(sourceId);
            const targetEl = document.getElementById(targetId);

            if (targetEl) {
                if (sourceEl.type === 'checkbox') targetEl.checked = sourceEl.checked;
                else targetEl.value = sourceEl.value;
            }

            // Always clear presets when manually changing dates
            if (baseId === 'start_date' || baseId === 'end_date') {
                document.getElementById('date-preset').value = '';
                document.getElementById('date-preset-bottom').value = '';

                // Save to localStorage
                const s = document.getElementById('start_date').value;
                const e = document.getElementById('end_date').value;
                if (s && e) {
                    localStorage.setItem('ns_start_date', s);
                    localStorage.setItem('ns_end_date', e);
                }
            }

            // Update URL and links without reloading
            updateToggleLinks();
            refreshAGP(true);
            refreshTrends(false);
        }

        function syncAndApplyPreset(fromBottom = false) {
            const sourcePreset = fromBottom ? 'date-preset-bottom' : 'date-preset';
            const targetPreset = fromBottom ? 'date-preset' : 'date-preset-bottom';
            const sourceToday = fromBottom ? 'include-today-bottom' : 'include-today';
            const targetToday = fromBottom ? 'include-today' : 'include-today-bottom';

            document.getElementById(targetPreset).value = document.getElementById(sourcePreset).value;
            document.getElementById(targetToday).checked = document.getElementById(sourceToday).checked;

            applyPreset();
        }

        function applyPreset() {
            let preset = document.getElementById('date-preset').value;
            const includeToday = document.getElementById('include-today').checked;

            function localDateStr(d) {
                return d.getFullYear() + '-'
                    + String(d.getMonth() + 1).padStart(2, '0') + '-'
                    + String(d.getDate()).padStart(2, '0');
            }

            const now = new Date();
            let start, end;

            if (preset === 'prev_1m') {
                start = new Date(now.getFullYear(), now.getMonth() - 1, 1);
                end = new Date(now.getFullYear(), now.getMonth(), 0);
            } else if (preset === 'prev_3m') {
                start = new Date(now.getFullYear(), now.getMonth() - 3, 1);
                end = new Date(now.getFullYear(), now.getMonth(), 0);
            } else if (preset === 'prev_6m') {
                start = new Date(now.getFullYear(), now.getMonth() - 6, 1);
                end = new Date(now.getFullYear(), now.getMonth(), 0);
            } else if (preset === 'prev_12m') {
                start = new Date(now.getFullYear(), now.getMonth() - 12, 1);
                end = new Date(now.getFullYear(), now.getMonth(), 0);
            } else if (preset) {
                end = new Date();
                if (!includeToday) end.setDate(end.getDate() - 1);
                start = new Date(end);
                start.setDate(start.getDate() - parseInt(preset) + 1);
            }

            if (start && end) {
                const sStr = localDateStr(start);
                const eStr = localDateStr(end);
                document.getElementById('start_date').value = sStr;
                document.getElementById('end_date').value = eStr;
                document.getElementById('start_date-bottom').value = sStr;
                document.getElementById('end_date-bottom').value = eStr;
                localStorage.setItem('ns_start_date', sStr);
                localStorage.setItem('ns_end_date', eStr);
                updateToggleLinks();
                refreshAGP(true);
                refreshTrends(false);
            }
        }

        function shiftPeriod(direction, fromBottom = false) {
            const startNode = fromBottom ? 'start_date-bottom' : 'start_date';
            const endNode = fromBottom ? 'end_date-bottom' : 'end_date';
            const startVal = document.getElementById(startNode).value;
            const endVal = document.getElementById(endNode).value;

            function localDateStr(d) {
                return d.getFullYear() + '-'
                    + String(d.getMonth() + 1).padStart(2, '0') + '-'
                    + String(d.getDate()).padStart(2, '0');
            }

            if (!startVal || !endVal) return;

            // Parse as local dates (avoid UTC midnight offset issues)
            const [sy, sm, sd] = startVal.split('-').map(Number);
            const [ey, em, ed] = endVal.split('-').map(Number);
            const start = new Date(sy, sm - 1, sd);
            const end = new Date(ey, em - 1, ed);

            const spanDays = Math.round((end - start) / 86400000) + 1;

            start.setDate(start.getDate() + direction * spanDays);
            end.setDate(end.getDate() + direction * spanDays);

            const sStr = localDateStr(start);
            const eStr = localDateStr(end);

            document.getElementById('start_date').value = sStr;
            document.getElementById('end_date').value = eStr;
            document.getElementById('start_date-bottom').value = sStr;
            document.getElementById('end_date-bottom').value = eStr;
            localStorage.setItem('ns_start_date', sStr);
            localStorage.setItem('ns_end_date', eStr);

            document.getElementById('date-preset').value = '';
            document.getElementById('date-preset-bottom').value = '';
            updateToggleLinks();
            refreshAGP(true);
            refreshTrends(false);
        }

        function updateToggleLinks() {
            const start = document.getElementById('start_date').value;
            const end = document.getElementById('end_date').value;
            const btns = document.querySelectorAll('a.btn');
            btns.forEach(b => {
                if (b.href.includes('start_date=')) {
                    const url = new URL(b.href, window.location.origin);
                    url.searchParams.set('start_date', start);
                    url.searchParams.set('end_date', end);
                    b.href = url.toString();
                }
            });
        }

        // State persistence helpers
        function getSavedVisibility(chartId, seriesName, defaultVal = true) {
            const key = `ns_chart_${chartId}_${seriesName}`;
            const val = localStorage.getItem(key);
            return val !== null ? val === 'true' : defaultVal;
        }

        function saveVisibility(chartId, seriesName, visible) {
            const key = `ns_chart_${chartId}_${seriesName}`;
            localStorage.setItem(key, visible);
        }

        function saveGrainState() {
            const grains = ['1', '7', '14', '30', '60', '90', 'monthly'];
            grains.forEach(g => {
                const el = document.getElementById(`grain-${g}`);
                if (el) localStorage.setItem(`ns_trends_grain_${g}`, el.checked);
            });
        }

        function toggleGrain(selectedId) {
            const grains = ['1', '7', '14', '30', '60', '90', 'monthly'];
            grains.forEach(g => {
                const el = document.getElementById(`grain-${g}`);
                if (el) el.checked = (g === selectedId);
            });
            saveGrainState();
            refreshTrends(false);
        }

        function loadGrainState() {
            const grains = ['1', '7', '14', '30', '60', '90', 'monthly'];
            let found = false;
            grains.forEach(g => {
                const el = document.getElementById(`grain-${g}`);
                if (!el) return;
                const val = localStorage.getItem(`ns_trends_grain_${g}`);
                if (val === 'true') {
                    el.checked = true;
                    found = true;
                } else {
                    el.checked = false;
                }
            });
            // Default to 1-Day if nothing saved or corrupted
            if (!found) {
                const g1 = document.getElementById('grain-1');
                if (g1) g1.checked = true;
            }
        }

        function syncToggles() {
            refreshAGP(false);
            refreshTrends(false);
        }

        function getChartParams() {
            const start = document.getElementById('start_date').value;
            const end = document.getElementById('end_date').value;
            const p = new URLSearchParams();
            p.set('start_date', start);
            p.set('end_date', end);

            // Include grain if monthly
            if (document.getElementById('grain-monthly') && document.getElementById('grain-monthly').checked) {
                p.set('grain', 'monthly');
            }

            return p.toString();
        }

        let agpChartInstance = null;
        async function refreshAGP(updateUrl = true) {
            const chartNode = document.getElementById('agp-chart-node');
            if (!chartNode) return;
            const loading = document.getElementById('agp-loading');
            loading.style.display = 'flex';
            loading.innerHTML = 'Fetching clinical AGP...';

            const params = getChartParams();
            const dataUrl = `/api/v1/agp_data?${params}&cb=${Date.now()}`;

            try {
                const response = await fetch(dataUrl);
                if (!response.ok) throw new Error('No AGP data');
                const raw = await response.json();

                loading.style.display = 'none';

                // --- Dynamic Y-Max: highest p90 rounded up to nearest even integer ---
                const maxP90 = Math.max(...raw.percentiles.map(p => parseFloat(p.p90)));
                const yMax = Math.ceil(maxP90 / 2) * 2;

                // --- Glucose series (all on primary left axis) ---
                // rangeArea fills ONLY between y[0] and y[1] — transparent below p10
                const timeToMin = (t) => {
                    const parts = t.split(':');
                    return parseInt(parts[0]) * 60 + parseInt(parts[1]);
                };

                // 1:1 Series to YAxis mapping requested by ApexCharts
                const series = [];
                const dynamicYaxis = [];
                const colors = [];
                const sWidths = [];
                const sCurves = [];
                const fOpacity = [];
                const fTypes = [];

                // 0. Target Range (Background Band - draws first/underneath everything)
                // We use rangeArea with constant values across the whole 24h period
                series.push({
                    name: 'Target Range',
                    type: 'rangeArea',
                    data: [
                        { x: 0, y: [3.9, 7.8] },
                        { x: 1440, y: [3.9, 7.8] }
                    ]
                });
                dynamicYaxis.push({ show: false, min: 0, max: yMax, tickAmount: yMax / 2 });
                colors.push('#90ee90'); sWidths.push(0); sCurves.push('straight'); fOpacity.push(0.35); fTypes.push('solid');

                // 1. Glucose Median (Line - draws on top, but first in legend)
                series.push({
                    name: 'Glucose Median',
                    type: 'line',
                    data: raw.percentiles.map(p => ({ x: timeToMin(p.time), y: parseFloat(p.p50) })).sort((a, b) => a.x - b.x)
                });
                dynamicYaxis.push({
                    show: true,
                    min: 0,
                    max: yMax,
                    tickAmount: yMax / 2,
                    title: { text: 'Glucose (mmol/L)' },
                    labels: { style: { colors: '#888' }, formatter: (v) => v.toFixed(1) }
                });
                colors.push('#1a1a1a'); sWidths.push(2.5); sCurves.push('smooth'); fOpacity.push(1); fTypes.push('solid');

                // 2. 10th-90th (RangeArea - draws first/underneath)
                series.push({
                    name: '10th-90th',
                    type: 'rangeArea',
                    data: raw.percentiles.map(p => ({ x: timeToMin(p.time), y: [parseFloat(p.p10), parseFloat(p.p90)] })).sort((a, b) => a.x - b.x)
                });
                dynamicYaxis.push({ show: false, min: 0, max: yMax, tickAmount: yMax / 2 });
                colors.push('#aacde8'); sWidths.push(0); sCurves.push('smooth'); fOpacity.push(0.4); fTypes.push('solid');

                // 3. 25th-75th (RangeArea - draws second/middle)
                series.push({
                    name: '25th-75th',
                    type: 'rangeArea',
                    data: raw.percentiles.map(p => ({ x: timeToMin(p.time), y: [parseFloat(p.p25), parseFloat(p.p75)] })).sort((a, b) => a.x - b.x)
                });
                dynamicYaxis.push({ show: false, min: 0, max: yMax, tickAmount: yMax / 2 });
                colors.push('#2278b5'); sWidths.push(0); sCurves.push('smooth'); fOpacity.push(0.55); fTypes.push('solid');

                // 4. Basal (Area - right axis)
                if (raw.basal && raw.basal.length > 0) {
                    series.push({
                        name: 'Basal Profile',
                        type: 'area',
                        data: raw.basal.map(b => ({ x: timeToMin(b.time), y: parseFloat(b.rate) })).sort((a, b) => a.x - b.x)
                    });
                    dynamicYaxis.push({
                        show: true,
                        opposite: true,
                        min: 0,
                        max: 10,
                        tickAmount: 10,
                        title: { text: 'Insulin (U) / Carbs (g/10)' },
                        labels: { style: { colors: '#888' }, formatter: (v) => v.toFixed(1) }
                    });
                    colors.push('#999999'); sWidths.push(0.5); sCurves.push('stepline'); fOpacity.push(0.3); fTypes.push('solid');
                }

                // 5/6. COB / IOB (Line - right axis)
                if (raw.overlays && raw.overlays.length > 0) {
                    series.push({
                        name: 'COB (gms/10)',
                        type: 'line',
                        data: raw.overlays.map(o => ({ x: timeToMin(o.time), y: parseFloat(o.avg_cob_smooth) * 0.1 })).sort((a, b) => a.x - b.x)
                    });
                    dynamicYaxis.push({ show: false, opposite: true, min: 0, max: 10, tickAmount: 10 });
                    colors.push('#E8630A'); sWidths.push(2); sCurves.push('smooth'); fOpacity.push(1); fTypes.push('solid');

                    series.push({
                        name: 'Nett IOB (U)',
                        type: 'line',
                        data: raw.overlays.map(o => ({ x: timeToMin(o.time), y: parseFloat(o.avg_iob) })).sort((a, b) => a.x - b.x)
                    });
                    dynamicYaxis.push({ show: false, opposite: true, min: 0, max: 10, tickAmount: 10 });
                    colors.push('#7B2FBE'); sWidths.push(2); sCurves.push('smooth'); fOpacity.push(1); fTypes.push('solid');
                }

                const bgiVals = raw.percentiles.map(p => parseFloat(p.bgi_p50)).filter(v => !isNaN(v));
                const devVals = raw.percentiles.map(p => parseFloat(p.dev_p50)).filter(v => !isNaN(v));
                const allVals = [...bgiVals, ...devVals];
                const axisMin = allVals.length ? Math.min(...allVals) : 0;
                const axisMax = allVals.length ? Math.max(...allVals) : 5;

                series.push({
                    name: 'Median BGI',
                    type: 'line',
                    data: raw.percentiles.map(p => ({ x: timeToMin(p.time), y: p.bgi_p50 !== null ? parseFloat(p.bgi_p50) : null })).sort((a, b) => a.x - b.x)
                });
                dynamicYaxis.push({
                    show: true,
                    opposite: true,
                    min: Math.floor(axisMin - 0.5),
                    max: Math.ceil(axisMax + 0.5),
                    title: { text: 'BGI / Deviation' },
                    labels: { style: { colors: '#E43F5A' }, formatter: (v) => v.toFixed(1) }
                });
                colors.push('#E43F5A'); sWidths.push(2); sCurves.push('smooth'); fOpacity.push(1); fTypes.push('solid');
                
                series.push({
                    name: 'Median Deviation',
                    type: 'line',
                    data: raw.percentiles.map(p => ({ x: timeToMin(p.time), y: p.dev_p50 !== null ? parseFloat(p.dev_p50) : null })).sort((a, b) => a.x - b.x)
                });
                dynamicYaxis.push({ show: false, opposite: true, min: Math.floor(axisMin - 0.5), max: Math.ceil(axisMax + 0.5) });
                colors.push('#17B978'); sWidths.push(2); sCurves.push('smooth'); fOpacity.push(1); fTypes.push('solid');

                const times = raw.percentiles.map(p => p.time);
                const options = {
                    series,
                    chart: {
                        height: 480,
                        type: 'line',
                        toolbar: { show: false },
                        zoom: { enabled: false },
                        animations: { enabled: false },
                        events: {
                            legendClick(ctx, idx, cfg) {
                                const nm = cfg.config.series[idx].name;
                                const vis = ctx.w.globals.collapsedSeriesIndices.includes(idx);
                                saveVisibility('agp', nm, vis);
                            }
                        }
                    },
                    colors,
                    stroke: { width: sWidths, curve: sCurves },
                    fill: { type: fTypes, opacity: fOpacity },
                    xaxis: {
                        type: 'numeric',
                        min: 0,
                        max: 1440,
                        tickAmount: 24, // Hourly grid lines native
                        labels: {
                            style: { colors: '#888' },
                            formatter(val) {
                                let h = Math.round(val / 60);
                                if (h % 3 === 0) { // Only show label every 3 hours
                                    if (h >= 24) h = 0;
                                    return `${h.toString().padStart(2, '0')}:00`;
                                }
                                return '';
                            }
                        },
                        axisTicks: { show: false },
                        axisBorder: { show: false },
                        tooltip: { enabled: false }
                    },
                    yaxis: dynamicYaxis,
                    grid: {
                        borderColor: '#e0e0e0',
                        position: 'back',
                        xaxis: { lines: { show: true } }, // Native hourly lines
                        yaxis: { lines: { show: true } },
                        padding: { bottom: 0 }
                    },
                    // Annotations removed in favor of native grid layering
                    legend: {
                        position: 'bottom',
                        horizontalAlign: 'center',
                        offsetY: 5
                    },
                    markers: { size: 0 },
                    tooltip: {
                        theme: 'dark',
                        shared: true,
                        intersect: false,
                        followCursor: true,
                        x: {
                            show: true,
                            formatter: function (val) {
                                let h = Math.floor(val / 60);
                                let m = Math.round(val % 60);
                                if (h >= 24) h = 0;
                                return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`;
                            }
                        },
                        y: {
                            formatter: function (val, { seriesIndex, dataPointIndex, w }) {
                                if (val == null) return "---";
                                if (Array.isArray(val)) {
                                    if (val[0] == null || val[1] == null) return "---";
                                    return val[0].toFixed(1) + " - " + val[1].toFixed(1);
                                }
                                return val.toFixed(1);
                            }
                        }
                    }
                };

                options.series.forEach((s, idx) => {
                    const isDefault = (s.name === 'Glucose Median' || s.name === '25th-75th' || s.name === '10th-90th' || s.name === 'Target Range');
                    if (!getSavedVisibility('agp', s.name, isDefault)) {
                        s.hidden = true;
                    }
                });

                if (agpChartInstance) {
                    agpChartInstance.destroy();
                }
                agpChartInstance = new ApexCharts(chartNode, options);
                await agpChartInstance.render();

            } catch (err) {
                console.error(err);
                loading.innerHTML = `<span style="color:var(--danger)">${err.message}</span>`;
            }
        }

        let trendsChartInstance = null;
        async function refreshTrends(updateUrl = true) {
            const chartNode = document.getElementById('trends-chart-node');
            if (!chartNode) return;
            const loading = document.getElementById('trends-loading');
            loading.style.display = 'flex';
            loading.innerHTML = 'Fetching trends data...';

            const params = getChartParams();
            const dataUrl = `/api/v1/trends_data?${params}&cb=${Date.now()}`;

            try {
                const response = await fetch(dataUrl);
                if (!response.ok) throw new Error('Failed to fetch data');
                const data = await response.json();

                if (!data || data.length === 0) {
                    loading.innerHTML = '<span style="color:var(--danger)">No trend data for this period.</span>';
                    return;
                }

                loading.style.display = 'none';
                const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                const dates = data.map(d => {
                    const raw = (d.Date || '').toString();
                    // Case 1: YYYY-MM-DD
                    if (raw.includes('-')) {
                        const parts = raw.split('-');
                        if (parts.length === 3) {
                            const yy = parts[0].slice(-2);
                            return ` ${parseInt(parts[2])} ${MONTHS[parseInt(parts[1]) - 1]} ${yy}`;
                        }
                    }
                    // Case 2: "Sat, 15 Feb 2025 00:00:00 GMT"
                    if (raw.includes(',')) {
                        const parts = raw.split(' ');
                        if (parts.length >= 4) {
                            const yy = parts[3].slice(-2);
                            return ` ${parts[1]} ${parts[2]} ${yy}`;
                        }
                    }
                    return " " + raw;
                });
                // axisGroup: series with the same group share a Y-axis scale
                // primaryAxis: set to name of the series that 'owns' this group's visible axis
                // axisLabel: label shown on the grouped Y-axis (shows all member names)
                const seriesDef = [
                    { name: 'GMI (%)', key: 'gmi', color: '#3498db', decimals: 1, axisGroup: 'gmi', showAxis: true, axisLabel: 'GMI (%)' },
                    { name: 'TIR (%)', key: 'TIR', color: '#2ecc71', min: 0, max: 100, decimals: 0, axisGroup: 'pct', showAxis: true, axisLabel: 'TIR / TITR (%)' },
                    { name: 'TITR (%)', key: 'TITR', color: '#004d40', min: 0, max: 100, decimals: 0, axisGroup: 'pct', showAxis: false, refAxis: 'TIR (%)', axisLabel: 'TIR / TITR (%)' },
                    { name: 'Avg BG', key: 'avg_bg', color: '#9b59b6', decimals: 1, axisGroup: 'avg_bg', showAxis: true, axisLabel: 'Avg BG (mmol/L)' },
                    { name: 'CV (%)', key: 'cv', color: '#8e44ad', decimals: 1, axisGroup: 'cv', showAxis: true, axisLabel: 'CV (%)' },
                    { name: 'GVI', key: 'gvi', color: '#f39c12', decimals: 2, axisGroup: 'gvi', showAxis: true, opposite: true, axisLabel: 'GVI' },
                    { name: 'LBGI', key: 'lbgi', color: '#ff5252', decimals: 2, axisGroup: 'risk', showAxis: true, opposite: true, axisLabel: 'LBGI / HBGI' },
                    { name: 'HBGI', key: 'hbgi', color: '#800000', decimals: 2, axisGroup: 'risk', showAxis: false, refAxis: 'LBGI', opposite: true, axisLabel: 'LBGI / HBGI' },
                    { name: 'TDD', key: 'tdd', color: '#7f8c8d', decimals: 1, axisGroup: 'tdd', showAxis: true, opposite: true, type: 'column', axisLabel: 'TDD' },
                    { name: 'Carbs (g)', key: 'carbs', color: '#f1c40f', decimals: 0, axisGroup: 'carbs', showAxis: true, opposite: true, type: 'column', axisLabel: 'Carbs (g)' }
                ];

                const series = [];
                const yaxis = [];

                const monthlyMode = document.getElementById('grain-monthly').checked;
                const grains = [];
                if (monthlyMode) {
                    grains.push({ id: 'monthly', suffix: ' (Monthly)', dash: 0, weight: 4 });
                } else {
                    grains.push({ id: '1', suffix: '', dash: 0, weight: 4 });
                    grains.push({ id: '7', suffix: ' (7d MAvg)', dash: 0, weight: 4 });
                    grains.push({ id: '14', suffix: ' (14d MAvg)', dash: 0, weight: 4 });
                    grains.push({ id: '30', suffix: ' (30d MAvg)', dash: 0, weight: 4 });
                    grains.push({ id: '60', suffix: ' (60d MAvg)', dash: 0, weight: 4 });
                    grains.push({ id: '90', suffix: ' (90d MAvg)', dash: 0, weight: 4 });
                }

                const activeGrains = grains.filter(g => document.getElementById(`grain-${g.id}`).checked);
                const activeGrain = activeGrains[0] || grains[0];

                const strokes = { width: [], dashArray: [] };

                const shownByDefault = ['GMI (%)', 'TIR (%)', 'GVI', 'LBGI'];

                seriesDef.forEach(def => {
                    const isMetricVisible = getSavedVisibility('trends', def.name, shownByDefault.includes(def.name));

                    activeGrains.forEach(grain => {
                        // FIX: Key case sensitivity (TIR/TITR in data are uppercase, but moving averages are lowercase in DB selection)
                        let key = (grain.id === '1' || grain.id === 'monthly') ? def.key : `${def.key.toLowerCase()}_${grain.id}d`;
                        
                        let sSuffix = grain.suffix;
                        if (def.name.includes('CV') && grain.id !== '1' && grain.id !== 'monthly') {
                            sSuffix = ` (${grain.id}d)`;
                        }

                        const sName = def.name + sSuffix;

                        series.push({
                            name: sName,
                            bareName: def.name, // Store bare name for stable color/legend lookups
                            type: def.type || 'line',
                            data: data.map(d => {
                                const v = parseFloat(d[key]);
                                return isNaN(v) ? null : v;
                            }),
                            // Hidden if the METRIC itself is toggled off in legend
                            hidden: !isMetricVisible
                        });

                        strokes.width.push(grain.weight);
                        strokes.dashArray.push(grain.dash);

                        yaxis.push({
                            seriesName: sName, // Use sName directly to match the series
                            show: def.showAxis, // Show axis for the metric if it's primary
                            min: def.min,
                            max: def.max,
                            opposite: !!def.opposite,
                            axisTicks: { show: def.showAxis },
                            axisBorder: { show: def.showAxis, color: def.color },
                            labels: {
                                show: def.showAxis,
                                style: { colors: def.color },
                                formatter: (val) => {
                                    const n = parseFloat(val);
                                    return isNaN(n) ? '' : n.toFixed(def.decimals);
                                }
                            },
                            title: (def.showAxis) ? { text: def.axisLabel || def.name, style: { color: def.color } } : { text: '' }
                        });
                    });
                });

                // Smart X-axis tick calculation
                let tickAmount = data.length;
                if (data.length > 90) tickAmount = Math.ceil(data.length / 14);
                else if (data.length > 60) tickAmount = Math.ceil(data.length / 7);
                else if (data.length > 30) tickAmount = Math.ceil(data.length / 3);
                else if (data.length > 14) tickAmount = Math.ceil(data.length / 2);

                const options = {
                    series: series,
                    chart: {
                        type: 'line',
                        height: 480,
                        zoom: { enabled: false },
                        toolbar: { show: false },
                        events: {
                            legendClick: function (chartContext, seriesIndex, config) {
                                const activeSeries = config.config.series[seriesIndex];
                                const sName = activeSeries.bareName; // Robust base name
                                const isVisible = chartContext.w.globals.collapsedSeriesIndices.includes(seriesIndex);
                                
                                saveVisibility('trends', sName, isVisible);

                                // Sync all grains of the same metric (if multiple grains are ever visible)
                                series.forEach((s, idx) => {
                                    if (s.bareName === sName) {
                                        if (isVisible) chartContext.showSeries(s.name);
                                        else chartContext.hideSeries(s.name);
                                    }
                                });
                            }
                        }
                    },
                    colors: series.map(s => {
                        return seriesDef.find(d => d.name === s.bareName).color;
                    }),
                    stroke: {
                        width: strokes.width,
                        dashArray: strokes.dashArray,
                        curve: 'straight'
                    },
                    xaxis: {
                        type: 'category',
                        categories: dates,
                        tickAmount: tickAmount,
                        labels: {
                            style: { colors: '#888' },
                            rotate: -45,
                            formatter: (val) => val
                        }
                    },
                    yaxis: yaxis,
                    tooltip: { shared: true, theme: 'dark' },
                    grid: { borderColor: '#eee', padding: { bottom: 0 } },
                    legend: { position: 'bottom', offsetY: 5 }
                };

                if (trendsChartInstance) {
                    trendsChartInstance.destroy();
                }
                trendsChartInstance = new ApexCharts(chartNode, options);
                await trendsChartInstance.render();

            } catch (err) {
                console.error(err);
                loading.innerHTML = '<span style="color:var(--danger)">Connection error.</span>';
            }

            if (updateUrl) {
                const newUrl = window.location.pathname + '?' + params;
                window.history.pushState({ path: newUrl }, '', newUrl);
            }
        }



        function initControls() {
            const today = "{{ today_local }}";

            // Initialize from localStorage if URL is bare
            const savedStart = localStorage.getItem('ns_start_date');
            const savedEnd = localStorage.getItem('ns_end_date');
            const params = new URLSearchParams(window.location.search);

            // If URL doesn't have dates but localStorage does, redirect with those dates
            if (!params.get('start_date') && savedStart && savedEnd) {
                params.set('start_date', savedStart);
                params.set('end_date', savedEnd);
                window.location.search = params.toString();
                return;
            }

            const endVal = document.getElementById('end_date').value;
            const startVal = document.getElementById('start_date').value;

            // Save current to localStorage
            if (startVal && endVal) {
                localStorage.setItem('ns_start_date', startVal);
                localStorage.setItem('ns_end_date', endVal);
            }

            // 2. Check/Uncheck "Include Today" based on end date
            const isToday = (endVal === today);
            document.getElementById('include-today').checked = isToday;
            if (document.getElementById('include-today-bottom')) {
                document.getElementById('include-today-bottom').checked = isToday;
            }

            updateToggleLinks();

            // 2. Sync Preset Select
            const presetSel = document.getElementById('date-preset');
            if (presetSel && startVal && endVal) {
                const dEnd = new Date(endVal + 'T00:00:00');
                const dStart = new Date(startVal + 'T00:00:00');

                // Priority A: Try to detect calendar periods (e.g. Previous 3 Months)
                // Range must start on the 1st of a month and end on the last day of a month
                const startDay = dStart.getDate();
                const endDay = dEnd.getDate();
                const nextMonth1st = new Date(dEnd.getFullYear(), dEnd.getMonth() + 1, 1);
                const endIsLastDayOfMonth = (nextMonth1st.getDate() === 1 && new Date(nextMonth1st - 1).getDate() === endDay);

                if (startDay === 1 && endIsLastDayOfMonth) {
                    const monthsDiff = (dEnd.getFullYear() - dStart.getFullYear()) * 12 + (dEnd.getMonth() - dStart.getMonth()) + 1;
                    if (monthsDiff === 1) presetSel.value = 'prev_1m';
                    else if (monthsDiff === 3) presetSel.value = 'prev_3m';
                    else if (monthsDiff === 6) presetSel.value = 'prev_6m';
                    else if (monthsDiff === 12) presetSel.value = 'prev_12m';
                    else presetSel.value = "";
                }

                // Priority B: Fallback to fixed-day ranges (e.g. Last 90 Days)
                const presetSelBottom = document.getElementById('date-preset-bottom');
                if (!presetSel.value) {
                    const diffDays = Math.round((dEnd - dStart) / 86400000) + 1;
                    const validDayOptions = ["7", "14", "30", "60", "90", "180"];
                    if (validDayOptions.includes(diffDays.toString())) {
                        presetSel.value = diffDays.toString();
                    } else {
                        presetSel.value = "";
                    }
                }
                if (presetSelBottom) presetSelBottom.value = presetSel.value;
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadGrainState();
            initControls();
            syncToggles();
        });
    </script>
</body>

</html>