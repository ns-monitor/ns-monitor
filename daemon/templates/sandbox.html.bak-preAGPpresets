<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sandbox - ns-monitor</title>
    <link rel="stylesheet" href="/static/css/ns-shared.css">
    <style>
        /* Retrofitted onto ns-shared.css 23 Aug 2026 (Phase 5, first page).
           Tokens, .container, .card, buttons, table, forms, empty/error
           states, and the (confirmed-dead) hamburger nav all now come from
           the shared stylesheet -- removed from here rather than
           duplicated. Genuinely page-local layout only below: the
           best/worst sentence-builder's own typography and small
           context-specific tweaks (.bw-sel highlighting the ranked
           column, .bw-dim de-emphasising coverage) that don't belong
           anywhere else on the site. See docs/style_guide.md. */
        body {
            padding: 20px;
            min-height: 100vh;
        }

        /* Confirmed-dead hamburger/nav-menu CSS and the matching JS block
           removed here (Phase 5 retrofit, 23 Aug 2026) -- verified across
           all 11 pages that had it: no page renders a matching
           class="hamburger" element, so this painted nothing and the JS
           (getElementById('hamburger-btn')) targeted a non-existent
           element, throwing on load. Leftover from before sidebar.html
           existed. See STATUS.md. The old unreferenced .empty-state (used
           nowhere in this page's markup) removed at the same time --
           ns-shared.css's .empty-state covers what .bw-empty needs below. */

        /* ---- Best/Worst Period Search (experimental, 23 Aug 2026) ----
           Retrofitted onto ns-shared.css 23 Aug 2026 (Phase 5 first page).
           .bw-btn/.bw-table/.bw-select/.bw-date/.bw-error/.bw-hint/.bw-empty
           all deleted from here -- they duplicated .btn/.panel-table/
           .form-select/.form-input/.error-banner/.hint/.empty-state, now in
           ns-shared.css. Markup below renamed to match. What's left here is
           genuinely page-local: the sentence-builder's own layout, and two
           small context-specific bits (.bw-sel highlights the ranked
           column, .bw-dim de-emphasises coverage) that don't belong
           anywhere else on the site. */
        .bw-card {
            padding: 20px 22px 24px;
        }

        .bw-title {
            margin: 0 0 18px;
            font-size: 1.15rem;
            font-weight: 600;
            letter-spacing: .01em;
        }

        .bw-sentence {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            font-size: 1.02rem;
            line-height: 2.1;
        }

        .bw-quick {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, .07);
            font-size: .9rem;
            color: var(--text-secondary);
        }

        .bw-summary {
            margin: 20px 0 10px;
            font-size: .95rem;
            color: var(--text-color);
        }

        /* The ranked statistic -- bolded in both the header and every cell.
           .panel-table's own specificity trick (th.num/td.num matching)
           applies the same way here: th.bw-sel needs to match td.bw-sel's
           specificity or the header silently loses. */
        .bw-sel {
            font-weight: 700;
            color: #fff;
        }
        .panel-table th.bw-sel {
            color: var(--accent);
        }

        .bw-rank {
            color: var(--text-secondary);
            font-variant-numeric: tabular-nums;
        }

        .bw-notes {
            margin: 14px 0 0;
            font-size: .84rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* .bw-empty now just adds this element's own top margin on top of
           ns-shared.css's .empty-state -- scoped by id since this is the
           only place on the page (and site, currently) needing it. */
        #bw-empty.empty-state {
            margin-top: 18px;
        }

        /* Coverage is a "nice to know", not a ranked stat -- dimmed further
           than --text-secondary (which the table headers already use) so
           it visibly recedes rather than competing with the actual stat
           columns. */
        .bw-dim {
            color: var(--text-secondary);
            opacity: .55;
        }
        .panel-table td.bw-dim {
            font-variant-numeric: tabular-nums;
        }
    </style>
</head>

<body>
    {% include "sidebar.html" %}

    <div class="container">
        <header class="page-header"><h1>Sandbox</h1></header>

        <!-- ================================================================
             EXPERIMENTAL: Best/Worst Period Search (23 Aug 2026)
             Self-contained. Talks only to /api/v1/sandbox/best_worst_period.
             No shared partials, no shared JS, no schema changes -- deleting
             this <div class="card"> block plus its <script> removes the
             feature entirely.
             ================================================================ -->
        <div class="card bw-card">
            <h2 class="bw-title">Best / Worst Period Search</h2>

            <div class="bw-sentence">
                <span>Find the</span>
                <select id="bw-direction" class="form-select">
                    <option value="best">best</option>
                    <option value="worst">worst</option>
                </select>
                <select id="bw-stat" class="form-select">
                    <option value="tir">TIR</option>
                    <option value="titr">TITR</option>
                    <option value="avg_bg">Avg BG</option>
                    <option value="gmi">GMI</option>
                    <option value="cv">CV</option>
                    <option value="tdd">TDD</option>
                    <option value="carbs">Carbs</option>
                    <option value="tar">TAR</option>
                    <option value="tbr">TBR</option>
                </select>
                <span>over</span>
                <select id="bw-period" class="form-select">
                    <option value="1">1 day</option>
                    <option value="2">2 days</option>
                    <option value="3">3 days</option>
                    <option value="7" selected>7 days</option>
                    <option value="14">14 days</option>
                    <option value="30">30 days</option>
                    <option value="60">60 days</option>
                    <option value="90">90 days</option>
                </select>
                <span>between</span>
                <input type="date" id="bw-start" class="form-input">
                <span>and</span>
                <input type="date" id="bw-end" class="form-input">
                <button id="bw-search" class="btn btn-primary">Search</button>
            </div>

            <div class="bw-quick">
                <label for="bw-preset">Quick select:</label>
                <select id="bw-preset" class="form-select">
                    <option value="">Custom Range...</option>
                    <option value="7">Last 7 Days</option>
                    <option value="14">Last 14 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="60">Last 60 Days</option>
                    <option value="90">Last 90 Days</option>
                    <option value="180">Last 180 Days</option>
                    <option value="" disabled>&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;</option>
                    <option value="prev_1m">Previous Month</option>
                    <option value="prev_3m">Previous 3 Months</option>
                    <option value="prev_6m">Previous 6 Months</option>
                    <option value="prev_12m">Previous 12 Months</option>
                </select>
                <span class="hint">Day-count presets end yesterday. Dates stay editable.</span>
            </div>

            <div id="bw-error" class="error-banner" style="display:none;"></div>

            <div id="bw-results" style="display:none;">
                <p id="bw-summary" class="bw-summary"></p>
                <table class="panel-table">
                    <thead>
                        <tr>
                            <th style="width:40px;">#</th>
                            <th>Period</th>
                            <th class="num" data-stat="tir">TIR %</th>
                            <th class="num" data-stat="titr">TITR %</th>
                            <th class="num" data-stat="avg_bg">Avg BG</th>
                            <th class="num" data-stat="gmi">GMI %</th>
                            <th class="num" data-stat="cv">CV %</th>
                            <th class="num" data-stat="tdd">TDD U</th>
                            <th class="num" data-stat="carbs">Carbs g</th>
                            <th class="num" data-stat="tar">TAR %</th>
                            <th class="num" data-stat="tbr">TBR %</th>
                            <!-- Deliberately last and visually de-emphasised (.bw-dim) --
                                 coverage is a "nice to know" sanity check, not one of the
                                 ranked/compared stats, so it doesn't compete with them for
                                 attention. Still real data, not decoration -- just muted. -->
                            <th class="num bw-dim">Coverage</th>
                        </tr>
                    </thead>
                    <tbody id="bw-tbody"></tbody>
                </table>
                <p id="bw-notes" class="bw-notes"></p>
            </div>

            <div id="bw-empty" class="empty-state" style="display:none;"></div>
        </div>

        <footer class="page-footer">{{ footer_text }}</footer>
    </div>

    <script>
        /* ---- Best/Worst Period Search (experimental, 23 Aug 2026) ----------
           Deliberately NOT wired into the shared date-selector partial/JS.
           This is a Sandbox trial; keeping it standalone means it can be
           deleted (or promoted) without touching anything else. If it gets
           promoted, that's the point to consider adopting the shared
           selector and the window.onDateOrPresetChange hook pattern. */
        (function () {
            'use strict';

            var STAT_LABELS = {
                tir: 'TIR', titr: 'TITR', avg_bg: 'Avg BG', gmi: 'GMI', cv: 'CV',
                tdd: 'TDD', carbs: 'Carbs', tar: 'TAR', tbr: 'TBR'
            };
            var STAT_UNITS = { tir: '%', titr: '%', avg_bg: ' mmol/L', cv: '%' };

            var elDirection = document.getElementById('bw-direction');
            var elStat = document.getElementById('bw-stat');
            var elPeriod = document.getElementById('bw-period');
            var elStart = document.getElementById('bw-start');
            var elEnd = document.getElementById('bw-end');
            var elPreset = document.getElementById('bw-preset');
            var elSearch = document.getElementById('bw-search');
            var elError = document.getElementById('bw-error');
            var elResults = document.getElementById('bw-results');
            var elSummary = document.getElementById('bw-summary');
            var elTbody = document.getElementById('bw-tbody');
            var elNotes = document.getElementById('bw-notes');
            var elEmpty = document.getElementById('bw-empty');

            function localDateStr(d) {
                return d.getFullYear() + '-'
                    + String(d.getMonth() + 1).padStart(2, '0') + '-'
                    + String(d.getDate()).padStart(2, '0');
            }

            function displayDate(iso) {
                var p = iso.split('-');
                return p[2] + '/' + p[1] + '/' + p[0].slice(2);
            }

            /* Mirrors the semantics of the shared date-selector-range.js
               presets (day-counts end yesterday; prev_Nm are whole calendar
               months ending last month-end) -- reimplemented locally rather
               than imported, so this trial has no shared dependency. */
            function applyPreset(preset) {
                if (!preset) return;
                var now = new Date();
                var start, end;
                var months = { prev_1m: 1, prev_3m: 3, prev_6m: 6, prev_12m: 12 };
                if (months[preset]) {
                    start = new Date(now.getFullYear(), now.getMonth() - months[preset], 1);
                    end = new Date(now.getFullYear(), now.getMonth(), 0);
                } else {
                    end = new Date();
                    end.setDate(end.getDate() - 1); // always ends yesterday
                    start = new Date(end);
                    start.setDate(start.getDate() - parseInt(preset, 10) + 1);
                }
                elStart.value = localDateStr(start);
                elEnd.value = localDateStr(end);
            }

            function showError(msg) {
                elError.textContent = msg;
                elError.style.display = '';
                elResults.style.display = 'none';
                elEmpty.style.display = 'none';
            }

            function clearError() {
                elError.style.display = 'none';
                elError.textContent = '';
            }

            function fmt(v, stat) {
                if (v === null || v === undefined) return '--';
                var twoDecimals = (stat === 'avg_bg' || stat === 'gmi');
                return twoDecimals ? v.toFixed(2) : v.toFixed(1);
            }

            function render(payload) {
                var meta = payload.meta;
                var rows = payload.results || [];
                var stat = meta.statistic;

                // Bold the ranked statistic's column, clear any previous one.
                var heads = document.querySelectorAll('.panel-table th[data-stat]');
                for (var h = 0; h < heads.length; h++) {
                    heads[h].classList.toggle('bw-sel', heads[h].getAttribute('data-stat') === stat);
                }

                elTbody.innerHTML = '';
                if (!rows.length) {
                    elResults.style.display = 'none';
                    elEmpty.style.display = '';
                    elEmpty.textContent = 'No window in that range met the '
                        + meta.min_coverage + '% sensor-coverage cut-off with a full '
                        + meta.period_days + '-day history. '
                        + '(' + meta.windows_tested + ' tested, '
                        + meta.excluded_low_coverage + ' below coverage, '
                        + meta.excluded_incomplete + ' incomplete.)';
                    return;
                }

                // Column order matches the <thead> above: stats sit right next to
                // rank/date (what you're actually comparing), coverage trails at
                // the far right, dimmed -- a "nice to know" sanity check, not
                // one of the ranked stats.
                var order = ['tir', 'titr', 'avg_bg', 'gmi', 'cv', 'tdd', 'carbs', 'tar', 'tbr'];
                rows.forEach(function (r) {
                    var tr = document.createElement('tr');
                    var cells = '<td class="bw-rank">' + r.rank + '</td>'
                        + '<td>' + displayDate(r.period_start) + ' &ndash; ' + displayDate(r.period_end) + '</td>';
                    order.forEach(function (k) {
                        cells += '<td class="num' + (k === stat ? ' bw-sel' : '') + '">'
                            + fmt(r[k], k) + '</td>';
                    });
                    cells += '<td class="num bw-dim">' + fmt(r.coverage, 'coverage') + '%</td>';
                    tr.innerHTML = cells;
                    elTbody.appendChild(tr);
                });

                elSummary.textContent = 'Top ' + rows.length + ' '
                    + meta.direction + ' ' + STAT_LABELS[stat] + ' over '
                    + meta.period_days + (meta.period_days === 1 ? ' day' : ' days')
                    + ', ranked 1st to ' + rows.length + 'th.';

                elNotes.innerHTML =
                    '&bull; ' + meta.windows_eligible + ' of ' + meta.windows_tested
                    + ' candidate windows were eligible &mdash; '
                    + meta.excluded_low_coverage + ' excluded for sensor coverage below '
                    + meta.min_coverage + '%, ' + meta.excluded_incomplete
                    + ' for an incomplete history.<br>'
                    + '&bull; Each window looks <em>backwards</em> from its end date, so a window '
                    + 'ending on the &lsquo;from&rsquo; date reaches into earlier data by design.<br>'
                    + '&bull; Windows may overlap &mdash; adjacent end dates share most of their days.<br>'
                    + '&bull; CV is the mean of the daily trailing-14-day CV across the window '
                    + '(never a daily CV), so CVs are comparable across period lengths.<br>'
                    + '&bull; For TDD and Carbs, &lsquo;best&rsquo; means the higher value &mdash; '
                    + 'a ranking convention, not a clinical judgement.';

                elEmpty.style.display = 'none';
                elResults.style.display = '';
            }

            function search() {
                clearError();
                var start = elStart.value;
                var end = elEnd.value;
                if (!start || !end) { showError('Please set both a from and a to date.'); return; }
                if (start > end) { showError('The \u2018from\u2019 date must not be after the \u2018to\u2019 date.'); return; }

                var params = new URLSearchParams({
                    stat: elStat.value,
                    period: elPeriod.value,
                    direction: elDirection.value,
                    start: start,
                    end: end
                });

                elSearch.disabled = true;
                elSearch.textContent = 'Searching...';
                fetch('/api/v1/sandbox/best_worst_period?' + params.toString())
                    .then(function (res) { return res.json().then(function (j) { return { ok: res.ok, body: j }; }); })
                    .then(function (r) {
                        if (!r.ok || r.body.error) { showError(r.body.error || 'Search failed.'); return; }
                        render(r.body);
                    })
                    .catch(function (e) { showError('Search failed: ' + e.message); })
                    .finally(function () {
                        elSearch.disabled = false;
                        elSearch.textContent = 'Search';
                    });
            }

            /* ---- State persistence -------------------------------------
               Every control in the sentence (plus the quick-select preset) is
               saved per-browser, so a refresh or a return visit comes back to
               the same question rather than resetting. Same localStorage
               approach the rest of the site already uses; keys namespaced
               `ns_bw_` so they can't collide with anything existing, and so
               they're easy to find and clear if this feature gets binned.

               Only the SETTINGS persist, deliberately not the results -- data
               can change underneath a saved result, and showing a stale table
               on load would be misleading. Search is always re-run explicitly. */
            var STORE = {
                direction: 'ns_bw_direction',
                stat: 'ns_bw_stat',
                period: 'ns_bw_period',
                start: 'ns_bw_start',
                end: 'ns_bw_end',
                preset: 'ns_bw_preset'
            };

            function saveState() {
                try {
                    localStorage.setItem(STORE.direction, elDirection.value);
                    localStorage.setItem(STORE.stat, elStat.value);
                    localStorage.setItem(STORE.period, elPeriod.value);
                    localStorage.setItem(STORE.start, elStart.value);
                    localStorage.setItem(STORE.end, elEnd.value);
                    localStorage.setItem(STORE.preset, elPreset.value);
                } catch (e) { /* private mode / quota -- not worth failing over */ }
            }

            // Only restore a value that's still a real option, so a saved
            // setting can never leave a <select> in an invalid state if the
            // option list is edited later.
            function restoreSelect(el, key) {
                var v = null;
                try { v = localStorage.getItem(key); } catch (e) { return false; }
                if (v === null) return false;
                for (var i = 0; i < el.options.length; i++) {
                    if (el.options[i].value === v && !el.options[i].disabled) {
                        el.value = v;
                        return true;
                    }
                }
                return false;
            }

            function restoreState() {
                restoreSelect(elDirection, STORE.direction);
                restoreSelect(elStat, STORE.stat);
                restoreSelect(elPeriod, STORE.period);

                var s = null, e = null;
                try {
                    s = localStorage.getItem(STORE.start);
                    e = localStorage.getItem(STORE.end);
                } catch (err) { /* ignore */ }

                // A saved day-count preset is re-APPLIED rather than restored
                // literally, so "Last 90 Days" still means the 90 days ending
                // yesterday when you come back a week later -- not the frozen
                // dates from last time. A custom range restores verbatim.
                var savedPreset = restoreSelect(elPreset, STORE.preset) ? elPreset.value : null;
                if (savedPreset) {
                    applyPreset(savedPreset);
                    return true;
                }
                if (s && e) {
                    elStart.value = s;
                    elEnd.value = e;
                    elPreset.value = '';
                    return true;
                }
                return false;
            }

            elPreset.addEventListener('change', function () {
                applyPreset(elPreset.value);
                saveState();
            });
            // Hand-editing a date means it's no longer a preset range.
            elStart.addEventListener('change', function () { elPreset.value = ''; saveState(); });
            elEnd.addEventListener('change', function () { elPreset.value = ''; saveState(); });
            elDirection.addEventListener('change', saveState);
            elStat.addEventListener('change', saveState);
            elPeriod.addEventListener('change', saveState);
            elSearch.addEventListener('click', search);

            // Restore last session's question; fall back to a sensible default
            // on a first visit. Nothing is searched until Search is hit.
            if (!restoreState()) {
                elPreset.value = '90';
                applyPreset('90');
            }
        })();
    </script>
</body>

</html>
